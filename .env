# 1️⃣填写Telegram bot信息：

# 通过 @BotFather 获取的 Telegram 机器人TOKEN密钥
TELEGRAM_BOT_TOKEN=你的TG机器人Token（格式示例8820700000:AAFEXXXXXXXXXX）

# 管理员的 Telegram 用户 ID，填 - 代表不设管理员
ADMIN_USER_IDS=你的TG_ID（格式示例7526XXXXXXX，纯数字）

# 允许使用机器人的 TG 用户 ID 列表（多个人用逗号隔开），或者填 * 允许所有人使用
ALLOWED_TELEGRAM_USER_IDS=你的TG_ID（格式示例7526XXXXXXX，纯数字）


# 2️⃣填写接入的文本模型API：

# ①原始OpenRouter接入API

OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=你的OpenRouter密钥API Keys（格式示例sk-or-v1-7beXXXXXXXXX）
OPENAI_MODEL=minimax/minimax-m3:free
VISION_MODEL="minimax/minimax-m3:free"
MAX_TOKENS=2000

# ②OpenRouter最常用的3个Free模型（自定义选择）
# MiniMax-M3
# OPENAI_MODEL=minimax/minimax-m3:free
# VISION_MODEL="minimax/minimax-m3:free"

# 智谱GLM
# OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# VISION_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# 英文回答laguna
# OPENAI_MODEL=poolside/laguna-s-2.1:free
# VISION_MODEL="poolside/laguna-s-2.1:free"


# 🐧 测试AMD接入API（佬王）

# AMD 接口地址
# OPENAI_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# 填入在 AMD 申请的 API Key
# OPENAI_API_KEY=你的 AMD 开发者平台API Key（格式示例rc-17099e9XXXXXXXXXXX）

# 默认文字对话模型（推荐 DeepSeek 或 Qwen）
# OPENAI_MODEL=DeepSeek-V4-Flash

# 识图模型（当你在 TG 发送图片给机器人时调用，支持 DeepSeek 或 Qwen3.8）
# VISION_MODEL=DeepSeek-V4-Flash-Vision-Exp

# 单次最大 Token 保持配置
# MAX_TOKENS=2000


3️⃣填写接入的画图模型API：
# 填入你的 Hugging Face 密钥
HF_TOKEN=你的HF密钥（格式示例hf_aRZbLXXXXXXXXX）

# 你想使用的画图模型 (这里默认填入 FLUX.1，你也可以随时换成Hugging Face其他免费的模型)
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
ENABLE_IMAGE_GENERATION=true

# 画图模型（可选）备注：Hugging Face有免费用量限制
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0


# 其它自定义参数

# Optional configuration, refer to the README for more details
